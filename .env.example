# ─────────────────────────────────────────────────────────────
# SideKick environment
# Copy this file to `.env.local` and fill in a key. Never commit .env.local.
# Without a key the app still runs in DEMO MODE (labelled sample copy).
# ─────────────────────────────────────────────────────────────

# Which provider to use for the content engine: "gemini" (free) or "claude".
AI_PROVIDER=gemini

# Google AI Studio key — FREE tier. Get one at https://aistudio.google.com/apikey
# Used when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Anthropic key — pay-per-use. Get one at https://console.anthropic.com/
# Used when AI_PROVIDER=claude. Leave blank until TRR approves and revenue covers it.
ANTHROPIC_API_KEY=

# Optional model overrides (sensible defaults are used if unset)
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Auto-posting (SideKick → Make.com → FB Page + Instagram) ──
# Make "Custom webhook" URL. Enables the Auto-post buttons.
MAKE_WEBHOOK_URL=

# ── Media hosting (Vercel Blob) ──
# Public URLs for Reel mp4s / graphics / uploaded photos so FB/IG can fetch
# them. Create a Blob store in the Vercel dashboard (Storage → Create → Blob) —
# it auto-adds this token to the project's env. For local dev, copy that token
# here. Free tier: 1 GB stored + ~10 GB transfer/mo.
BLOB_READ_WRITE_TOKEN=

# ── Social posting + connect portal ──
# POSTING_PROVIDER picks the backend: `postpeer` (production) or `zernio`.
# Unset behaves as `zernio`, which is what a fresh local checkout gets.
POSTING_PROVIDER=
# Zernio's audited apps post public with no per-account audit. Sign up at
# zernio.com (free tier); copy the API key here. The Connect page + posting all
# run through one profile (one per agent — create via POST /api/v1/profiles).
ZERNIO_API_KEY=
# REQUIRED for local dev on the zernio provider — there is no default any more.
#
# A hardcoded pilot profile used to stand behind this ('6a6c4989…', removed
# 2026-09-04). It meant a blank value here published to somebody's REAL accounts,
# and it made "set a profile id to fix the No-accounts badge" the obvious wrong
# move: any sender not mapped in tools/tenants.json resolves to whatever is set
# here and posts to its owner. Leave it blank and every posting call refuses in
# words; fill it in and they all go to that one profile.
ZERNIO_PROFILE_ID=
# Legacy pilot: single hardcoded TikTok account for the FB+TikTok reel button.
# Optional now — the portal uses the profile's connected accounts instead.
ZERNIO_TIKTOK_ACCOUNT_ID=

# The PostPeer profile to fall back to when a caller names none.
#
# LEAVE THIS BLANK IN PRODUCTION. It is a single shared tenant: setting it makes
# every unmapped sender publish to one agent's Facebook, Instagram and TikTok.
# Per-agent profiles come from tools/tenants.json (phone → profileId), which is
# how a multi-tenant install is meant to work.
POSTPEER_PROFILE_ID=

# ── App host (optional) ──
# The public host the portal is served from, e.g. sidekick-demopromax.vercel.app.
# /api/social-broadcast's "did this come from our own pages?" check compares the
# request's Origin against this. Without it the check falls back to comparing
# Origin against the request's own Host header — which the caller also supplies,
# so `-H "host: evil.test" -H "origin: https://evil.test"` matched itself.
# Vercel's own VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL are used when set.
APP_HOST=

# ── Per-agent link tokens (optional, not yet enforced) ──
# Secret used to mint the `t=` token on a per-agent Connect/Style link
# (api/_lib/tenant.js). Falls back to INGEST_SECRET when unset. Presenting a
# valid token is accepted as proof of which agent is calling; presenting none is
# still allowed, because every link already in an agent's WhatsApp predates it.
LINK_SECRET=
