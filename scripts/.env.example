# Copy to scripts/.env and fill in — NEVER commit the real .env.
# Get these from developers.facebook.com (your app) + Graph API Explorer.

META_PAGE_ID=          # your Facebook Page's numeric ID
META_PAGE_TOKEN=       # Page access token (pages_manage_posts, instagram_content_publish, instagram_basic)
META_IG_USER_ID=       # optional: the Instagram Business account id linked to that Page

# ── Ayrshare (recommended — no Meta developer account needed) ──
# Sign up free at ayrshare.com → connect your FB Page + IG in their dashboard →
# copy the API key here. This is the path that skips Facebook's dev portal.
AYRSHARE_API_KEY=      # from your Ayrshare dashboard
AYRSHARE_PROFILE_KEY=  # optional: only when posting per-agent (multi-user)

# ── Make.com (cheapest — free tier, no Meta app) ──
# Build a scenario: Custom webhook → Facebook Pages "Create a Post" (+ Instagram).
# Copy the webhook URL here. See scripts/make-post.mjs header for the exact steps.
MAKE_WEBHOOK_URL=      # from your Make "Custom webhook" trigger
